{
   "name": "server",
   "version": "1.0.0",
   "main": "dist/src/index.js",
   "scripts": {
      "test": "echo \"Error: no test specified\" && exit 1",
      "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && cp API.md BASE.md ARCHITECTURE.md dist/",
      "start": "node dist/src/index.js",
      "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
      "scripts": "tsx prisma/scripts.ts",
      "postinstall": "prisma generate",
      "db:push": "prisma db push",
      "db:migrate": "prisma migrate dev && prisma generate",
      "db:studio": "prisma studio",
      "db:seed": "tsx prisma/seed/index.ts",
      "db:reset": "prisma migrate reset",
      "db:restart": "yarn db:reset && yarn db:migrate && yarn db:seed"
   },
   "author": "",
   "license": "ISC",
   "description": "",
   "dependencies": {
      "@aws-sdk/client-s3": "^3.1089.0",
      "@aws-sdk/s3-request-presigner": "^3.1089.0",
      "@prisma/adapter-pg": "^7.8.0",
      "@prisma/client": "^7.8.0",
      "bcrypt": "^5.1.1",
      "cookie-parser": "^1.4.7",
      "cors": "^2.8.5",
      "dotenv": "^16.6.1",
      "express": "^5.2.1",
      "jsonwebtoken": "^9.0.2",
      "marked": "^18.0.4",
      "nodemailer": "^7.0.9",
      "pg": "^8.20.0",
      "swagger-jsdoc": "^6.2.8",
      "swagger-ui-express": "^5.0.1",
      "ts-node": "^10.9.2",
      "tsc-alias": "^1.8.16",
      "tsconfig-paths": "^4.2.0",
      "tsx": "^4.19.3"
   },
   "devDependencies": {
      "@types/bcrypt": "^5.0.2",
      "@types/cookie-parser": "^1.4.8",
      "@types/cors": "^2.8.17",
      "@types/express": "^5.0.0",
      "@types/jsonwebtoken": "^9.0.9",
      "@types/nodemailer": "^6.4.17",
      "@types/pg": "^8.20.0",
      "@types/swagger-jsdoc": "^6.0.4",
      "@types/swagger-ui-express": "^4.1.8",
      "prisma": "^7.8.0",
      "typescript": "^5.8.2"
   }
}
